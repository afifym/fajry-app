{
  "expo": {
    "name": "Fajry",
    "slug": "fajry-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fajryapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1612",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.afify.fajry-app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to calculate accurate Fajr prayer times. It never leaves your device.",
        "NSAlarmKitUsageDescription": "Fajry uses a system alarm to wake you for Fajr. It rings on the Lock Screen even in Silent mode or Focus.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1612",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.afify.fajryapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1612",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "./plugins/withNotifeeAndroid",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f5e4382-f553-43e6-802f-7fc33f3d9e55"
      }
    },
    "owner": "afifym",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f5e4382-f553-43e6-802f-7fc33f3d9e55"
    }
  }
}
